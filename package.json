{
    "name": "bekk",
    "version": "0.5.6",
    "description": "Backup CLI for Windows",
    "homepage": "https://github.com/liry24/bekk#readme",
    "bugs": {
        "url": "https://github.com/liry24/bekk/issues"
    },
    "license": "MIT",
    "author": {
        "name": "Liry24",
        "url": "https://liry24.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/bekk.git"
    },
    "bin": {
        "bekk": "dist/bekk"
    },
    "files": [
        "dist/bekk",
        "dist/bekk.cmd",
        "dist/*-bun-*",
        "dist/bekk-core*"
    ],
    "type": "module",
    "scripts": {
        "dev": "bun run src/cli.ts",
        "build": "crust build",
        "package": "crust build --package",
        "publish": "crust publish --stage-dir dist/npm",
        "prepack": "bun run build",
        "build:core": "cargo build --manifest-path bekk-core/Cargo.toml",
        "build:core:release": "cargo build --release --manifest-path bekk-core/Cargo.toml",
        "build:all": "bun run build:core && bun run build",
        "cargo:check": "cargo check --manifest-path bekk-core/Cargo.toml",
        "start": "./dist/bekk",
        "check:types": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:core": "bun run build:core && bun test tests/integration/bekk-core.test.ts",
        "bump:hook": "cargo update bekk-core --manifest-path bekk-core/Cargo.toml"
    },
    "dependencies": {
        "@crustjs/core": "0.0.16",
        "@crustjs/crust": "0.0.23",
        "@crustjs/plugins": "0.0.22",
        "@crustjs/store": "0.0.4",
        "@crustjs/validate": "0.0.15",
        "@opentui/core": "^0.2.9",
        "cli-spinners": "^3.4.0",
        "consola": "^3.4.2",
        "destr": "^2.0.5",
        "ofetch": "^1.5.1",
        "open": "^11.0.0",
        "pathe": "^2.0.3",
        "uqr": "^0.1.3",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "bumpp": "11.1.0",
        "oxfmt": "^0.49.0",
        "oxlint": "^1.64.0",
        "taze": "^19.11.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "bun": "1.3.14"
    },
    "packageManager": "bun@1.3.14"
}
